{
  "name": "baanrodmai",
  "private": true,
  "version": "1.1.0",
  "description": "บ้านรอดไหม? (Baan Rod Mai?) — a 60-second Thai flood-safety hazard-hunt web game for Cloudflare Pages",
  "homepage": "https://github.com/bejranonda/Hazard-huntz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bejranonda/Hazard-huntz.git"
  },
  "bugs": {
    "url": "https://github.com/bejranonda/Hazard-huntz/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "docs": "node tools/build.mjs --docs",
    "images": "node tools/render-images.mjs",
    "test": "node tests/run.mjs",
    "smoke": "node tests/smoke.mjs",
    "probe": "node tools/probe.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "dev": "npx wrangler@latest pages dev public",
    "deploy": "node tools/build.mjs && npx wrangler@latest pages deploy public --project-name=baanrodmai"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
